# MySQL service
MYSQL_DATABASE=app
MYSQL_USER=app
MYSQL_PASSWORD=app
MYSQL_ROOT_PASSWORD=root

# RabbitMQ service
RABBITMQ_USER=app
RABBITMQ_PASSWORD=app

# PHP Xdebug
XDEBUG_MODE=debug,develop

# Session cookie security; enable behind HTTPS, including TLS-terminating proxies
SESSION_COOKIE_SECURE=false

# Symfony Messenger transports; by default built from the RabbitMQ credentials above
# MESSENGER_EMAILS_DSN=amqp://app:app@rabbitmq:5672/%2f/emails
# MESSENGER_ORDERS_DSN=amqp://app:app@rabbitmq:5672/%2f/orders
# MESSENGER_CATALOG_DSN=amqp://app:app@rabbitmq:5672/%2f/catalog
# MESSENGER_FAILED_DSN=amqp://app:app@rabbitmq:5672/%2f/failed_messages

# Worker mailer and public application URL used in confirmation links
MAILER_DSN=smtp://mailpit:1025
APP_BASE_URL=http://localhost:8080
MAILER_FROM=no-reply@example.com

# Simulated payment providers; set real checkout URLs and secrets per deployment
FAKEPAY_CHECKOUT_URL=http://localhost:8080/fakepay
FAKEPAY_WEBHOOK_SECRET=local-fakepay-webhook-secret
QUICKPAY_CHECKOUT_URL=http://localhost:8080/quickpay
QUICKPAY_WEBHOOK_SECRET=local-quickpay-webhook-secret

# How long checkout reserves stock before an unpaid order expires
ORDER_RESERVATION_SECONDS=900

# Redis cache; the test stack uses database 1
REDIS_HOST=redis
REDIS_PORT=6379
REDIS_DATABASE=0

# Secret for the X-Api-Key header of the reporting API; set a strong value per deployment
REPORTS_API_KEY=local-reports-api-key
