# MySQL service
MYSQL_DATABASE=app
MYSQL_USER=app
MYSQL_PASSWORD=app
MYSQL_ROOT_PASSWORD=root

# RabbitMQ service
RABBITMQ_USER=app
RABBITMQ_PASSWORD=app

# PHP Xdebug
XDEBUG_MODE=debug,develop

# Symfony Messenger transports
MESSENGER_TRANSPORT_DSN=amqp://app:app@rabbitmq:5672/%2f/emails
MESSENGER_FAILURE_TRANSPORT_DSN=amqp://app:app@rabbitmq:5672/%2f/emails_failed

# MailHog SMTP and application URL used in confirmation links
MAILER_DSN=smtp://mailhog:1025
APP_BASE_URL=http://localhost:8080
