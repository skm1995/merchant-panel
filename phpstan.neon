parameters:
    level: 8
    paths:
        - src
        - public
        - tests
        - views
        - database/migrations
        - phinx.php
        - tools
        - bin
    tmpDir: .phpstan-cache

services:
    -
        class: Tools\PHPStan\HydratedRecordPropertiesExtension
        tags:
            - phpstan.properties.readWriteExtension
