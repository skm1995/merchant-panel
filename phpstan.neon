parameters:
    level: 8
    paths:
        - src
        - public
        - tests
        - views
        - database/migrations
        - phinx.php
        - tools
        - config
        - bin
    excludePaths:
        # Legacy code imported as found; it is characterized by tests and then replaced.
        - public/legacy
    tmpDir: .phpstan-cache

services:
    -
        class: Tools\PHPStan\HydratedRecordPropertiesExtension
        tags:
            - phpstan.properties.readWriteExtension
