#!/usr/bin/env bash
# Deploys the checked-out commit to the production server: prepares the server, uploads
# the commit's configuration over SSH, writes the server's .env from this environment, pulls
# the commit's images that bin/publish-images pushed, starts compose.prod.yaml, and checks
# that the site answers over HTTPS. The deploy job in .github/workflows/ci.yaml runs it after
# CI passes on master. The running release is replaced only once every image is pulled, so a
# failed pull leaves it as it was.

set -euo pipefail

cd "$(dirname "$0")/.."

required=(
    DEPLOY_HOST DEPLOY_USER DEPLOY_SSH_KEY DEPLOY_KNOWN_HOSTS BASE_DOMAIN
    MYSQL_PASSWORD MYSQL_ROOT_PASSWORD RABBITMQ_PASSWORD
    FAKEPAY_WEBHOOK_SECRET QUICKPAY_WEBHOOK_SECRET REPORTS_API_KEY ORDER_ACCESS_SECRET MAILPIT_PASSWORD
    BACKUP_UPLOAD_URL IMAGES IMAGE_TAG REGISTRY_USER REGISTRY_TOKEN
)
for name in "${required[@]}"; do
    if [ -z "${!name:-}" ]; then
        echo "Required environment variable \"${name}\" is not set." >&2
        exit 1
    fi
done

caddy_image=caddy:2.10.2-alpine
app_domain="demo.${BASE_DOMAIN}"
mail_domain="mail.${BASE_DOMAIN}"
smoke_test_attempts=30
workdir=$(mktemp -d)
trap 'rm -rf "${workdir}"' EXIT

install -m 600 /dev/null "${workdir}/key"
printf '%s\n' "${DEPLOY_SSH_KEY}" > "${workdir}/key"
printf '%s\n' "${DEPLOY_KNOWN_HOSTS}" > "${workdir}/known_hosts"
ssh=(ssh -i "${workdir}/key" -o UserKnownHostsFile="${workdir}/known_hosts" -o StrictHostKeyChecking=yes "${DEPLOY_USER}@${DEPLOY_HOST}")

install -m 600 /dev/null "${workdir}/.env"
cat > "${workdir}/.env" <<ENV
IMAGES=${IMAGES}
IMAGE_TAG=${IMAGE_TAG}
APP_DOMAIN=${app_domain}
MAIL_DOMAIN=${mail_domain}
MYSQL_DATABASE=app
MYSQL_USER=app
MYSQL_PASSWORD=${MYSQL_PASSWORD}
MYSQL_ROOT_PASSWORD=${MYSQL_ROOT_PASSWORD}
RABBITMQ_USER=app
RABBITMQ_PASSWORD=${RABBITMQ_PASSWORD}
MAILER_FROM=no-reply@${BASE_DOMAIN}
FAKEPAY_CHECKOUT_URL=https://${app_domain}/fakepay
FAKEPAY_WEBHOOK_SECRET=${FAKEPAY_WEBHOOK_SECRET}
QUICKPAY_CHECKOUT_URL=https://${app_domain}/quickpay
QUICKPAY_WEBHOOK_SECRET=${QUICKPAY_WEBHOOK_SECRET}
REPORTS_API_KEY=${REPORTS_API_KEY}
ORDER_ACCESS_SECRET=${ORDER_ACCESS_SECRET}
MAILPIT_PASSWORD=${MAILPIT_PASSWORD}
# Read by docker/server/backup-database.sh; it may only write objects into the backup bucket.
BACKUP_UPLOAD_URL=${BACKUP_UPLOAD_URL}
# Lifts the rate limits for the Black Friday simulator only; a new key on every deployment.
LOAD_TEST_KEY=$(openssl rand -hex 32)
ENV

echo "Preparing the server..."
"${ssh[@]}" 'bash -s' < docker/server/provision.sh

echo "Uploading $(git rev-parse --short HEAD)..."
git archive --format=tar HEAD | "${ssh[@]}" 'rm -rf app.next && mkdir app.next && tar -x -C app.next'
"${ssh[@]}" 'umask 077 && cat > app.next/.env' < "${workdir}/.env"

# The workflow's token is valid only while the job runs; it goes over standard input, and the
# server forgets it right after the pull.
echo "Pulling the images of $(git rev-parse --short HEAD)..."
"${ssh[@]}" "sudo docker login ${IMAGES%%/*} --username ${REGISTRY_USER} --password-stdin >/dev/null" <<< "${REGISTRY_TOKEN}"
pulled=0
"${ssh[@]}" "CADDY_IMAGE=${caddy_image} bash -s" <<'PULL' || pulled=$?
set -euo pipefail
cd app.next
# Compose reads the whole file, Caddy's required password hash included, even to pull.
password=$(sed -n 's/^MAILPIT_PASSWORD=//p' .env)
hash=$(sudo docker run --rm "${CADDY_IMAGE}" caddy hash-password --plaintext "${password}")
echo "MAILPIT_PASSWORD_HASH='${hash}'" >> .env
sudo docker compose -f compose.prod.yaml pull --quiet
PULL
"${ssh[@]}" "sudo docker logout ${IMAGES%%/*} >/dev/null"
[ "${pulled}" -eq 0 ]

echo "Starting the services..."
"${ssh[@]}" 'bash -s' <<'REMOTE'
set -euo pipefail
rm -rf app
mv app.next app
cd app
sudo docker compose -f compose.prod.yaml up --detach --no-build --remove-orphans --wait
sudo docker compose -f compose.prod.yaml run --rm -T seed-demo < /dev/null
sudo docker compose -f compose.prod.yaml run --rm -T kibana-setup < /dev/null
# The shared demo account; status 3 means it already exists, so a redeploy keeps its data.
set -a && . docker/env/demo.env && set +a
status=0
sudo docker compose -f compose.prod.yaml run --rm -T --no-deps --user www-data -e "MERCHANT_PASSWORD=${DEMO_MERCHANT_PASSWORD}" \
    php php bin/create-merchant.php "${DEMO_MERCHANT_EMAIL}" < /dev/null || status=$?
[ "${status}" -eq 0 ] || [ "${status}" -eq 3 ]
# Every release adds tagged images; the registry keeps them, so the server keeps only those in use.
sudo docker image prune --all --force >/dev/null
REMOTE

echo "Checking https://${app_domain}..."
for _ in $(seq 1 "${smoke_test_attempts}"); do
    if curl --fail --silent --output /dev/null "https://${app_domain}/api/v1/products?limit=1"; then
        echo "Deployed: https://${app_domain}"
        exit 0
    fi
    sleep 2
done

echo "https://${app_domain} does not answer." >&2
exit 1
