#!/usr/bin/env bash
# Runs the complete CI verification against the Docker Compose stack.
# GitHub Actions and local pre-push checks use this same script.

set -euo pipefail

cd "$(dirname "$0")/.."

compose=(docker compose --profile test)
run=("${compose[@]}" run --rm --no-deps php-test)
node=(docker compose --profile tools run --rm --no-deps --env NPM_CONFIG_UPDATE_NOTIFIER=false frontend-test)

# No secret may reach the repository; .gitleaks.toml lists the values that are public on purpose.
docker run --rm -v "$PWD:/repo" zricethezav/gitleaks:v8.28.0 git /repo --config /repo/.gitleaks.toml --no-banner --redact

"${compose[@]}" build
"${run[@]}" composer install --no-interaction --no-progress
"${node[@]}" npm ci
"${node[@]}" npm run build
# Coverage of every suite, including requests the test web server handles, is merged at the end.
"${run[@]}" composer coverage-prepare
"${compose[@]}" up --detach --wait
# The audits cover what reaches the server; Dependabot also proposes updates of the tools.
backend_checks() {
    "${run[@]}" composer validate --no-check-publish
    "${run[@]}" composer audit --no-dev
    "${run[@]}" composer openapi-validate
    "${run[@]}" composer coverage-unit
    "${run[@]}" composer api-calls-reset
    "${run[@]}" composer coverage-functional
    "${run[@]}" composer api-calls-check
    "${run[@]}" composer analyse
    "${run[@]}" composer deptrac
    "${run[@]}" composer cs-check
}

frontend_checks() {
    "${node[@]}" npm audit --omit=dev
    "${node[@]}" npm run api:check
    "${node[@]}" npm run typecheck
    "${node[@]}" npm run lint
    "${node[@]}" npm run format:check
    "${node[@]}" npm run test:coverage
}

# The two sides do not depend on each other, so their checks run at the same time; each
# writes its own log, printed whole once both are done.
logs=$(mktemp -d)
trap 'rm -rf "${logs}"' EXIT
backend_checks > "${logs}/backend.log" 2>&1 &
backend=$!
frontend_checks > "${logs}/frontend.log" 2>&1 &
frontend=$!
failed=0
wait "${backend}" || failed=1
cat "${logs}/backend.log"
wait "${frontend}" || failed=1
cat "${logs}/frontend.log"
if (( failed )); then
    echo "Backend or frontend checks failed; see the logs above." >&2
    exit 1
fi

"${run[@]}" php tests/Fixture/reset-demo-merchant.php
docker compose --profile tools run --rm --no-deps e2e npx playwright test
"${run[@]}" composer coverage-report
"${run[@]}" composer coverage-check
