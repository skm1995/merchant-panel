# Routes owned by the PHP backend, the JSON API and the legacy order report URL, plus the
# proxy's own health check. Imported with the PHP-FPM address: `import backend.caddy php:9000`.
# Every backend request runs the front controller, whose path is in the PHP container, so
# Caddy never looks for the file itself; PHP still sees the original request URI.
@backend path /api/* /legacy/*
handle @backend {
	# The API takes JSON of a few kilobytes; larger bodies get 413 before PHP reads them.
	request_body {
		max_size 1MB
	}
	root * /app/backend/public
	rewrite * /index.php
	reverse_proxy {args[0]} {
		transport fastcgi {
			split .php
		}
	}
}

handle /healthz {
	respond 204
}
