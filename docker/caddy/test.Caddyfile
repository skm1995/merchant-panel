# Tests: the production build of the React app; unknown paths fall back to index.html so
# the router handles them.
{
	admin off
	auto_https off
}

:80 {
	# Access logs show, when a test fails on a transport error, whether the request reached the proxy.
	log
	import /etc/caddy/headers.caddy
	import /etc/caddy/backend.caddy php-test-web:9000

	handle {
		root * /app/frontend/dist
		try_files {path} /index.html
		file_server
	}
}
