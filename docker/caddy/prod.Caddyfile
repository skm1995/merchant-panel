# Production: the panel and API on the application domain, and the demo's tools behind a
# password on the mail domain (Mailpit, and Kibana under /kibana/), both with HTTPS
# certificates Caddy obtains and renews itself.
{
	admin off
}

{$APP_DOMAIN} {
	encode zstd gzip
	import /etc/caddy/access-log.caddy
	import /etc/caddy/headers.caddy
	header Strict-Transport-Security "max-age=31536000; includeSubDomains"
	import /etc/caddy/backend.caddy php:9000

	handle {
		root * /srv/frontend
		try_files {path} /index.html
		file_server
	}
}

{$MAIL_DOMAIN} {
	basic_auth {
		demo {$MAILPIT_PASSWORD_HASH}
	}

	# Kibana serves itself under /kibana (server.basePath), so the path is passed on as is.
	handle /kibana* {
		reverse_proxy kibana:5601
	}

	handle {
		reverse_proxy mailpit:8025
	}
}

# Docker's health check only; this port is not published.
:8080 {
	respond /healthz 204
}
