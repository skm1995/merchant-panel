# Production: HTTPS for the application domain with certificates Caddy obtains and renews
# itself, and Mailpit behind a password on the mail subdomain, so demo visitors can read
# their confirmation emails.
{
	admin off
}

{$APP_DOMAIN} {
	encode zstd gzip
	log
	import /etc/caddy/headers.caddy
	header Strict-Transport-Security "max-age=31536000; includeSubDomains"
	import /etc/caddy/backend.caddy php:80

	handle {
		root * /srv/frontend
		try_files {path} /index.html
		file_server
	}
}

mail.{$APP_DOMAIN} {
	basic_auth {
		demo {$MAILPIT_PASSWORD_HASH}
	}
	reverse_proxy mailpit:8025
}

# Docker's health check only; this port is not published.
:8080 {
	respond /healthz 204
}
