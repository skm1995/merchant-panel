{
    "name": "vanilla-php-playground/app",
    "description": "Vanilla PHP application playground",
    "type": "project",
    "require": {
        "php": "^8.5",
        "ext-filter": "*",
        "ext-hash": "*",
        "ext-pdo": "*",
        "ext-pdo_mysql": "*",
        "ext-session": "*",
        "symfony/amqp-messenger": "^8.1",
        "symfony/event-dispatcher": "^8.1",
        "symfony/mailer": "^8.1",
        "symfony/messenger": "^8.1"
    },
    "require-dev": {
        "ext-json": "*",
        "friendsofphp/php-cs-fixer": "^3.0",
        "phpstan/phpstan": "^2.1",
        "phpunit/phpunit": "^12.5",
        "robmorgan/phinx": "^0.16",
        "symfony/browser-kit": "^8.1",
        "symfony/css-selector": "^8.1",
        "symfony/dom-crawler": "^8.1",
        "symfony/http-client": "^8.1"
    },
    "autoload": {
        "psr-4": {
            "App\\": "src/"
        }
    },
    "autoload-dev": {
        "psr-4": {
            "Tests\\": "tests/"
        }
    },
    "config": {
        "sort-packages": true
    },
    "scripts": {
        "test": "phpunit",
        "test-unit": "phpunit --testsuite Unit",
        "test-functional": "phpunit --testsuite Functional",
        "analyse": "phpstan analyse --configuration=phpstan.neon --no-progress",
        "cs-check": "php-cs-fixer fix --dry-run --diff --config=.php-cs-fixer.dist.php",
        "cs-fix": "php-cs-fixer fix --config=.php-cs-fixer.dist.php",
        "migrate": "phinx migrate -c phinx.php"
    }
}
