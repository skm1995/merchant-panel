{
    "name": "vanilla-php-playground/app",
    "description": "Vanilla PHP application playground",
    "type": "project",
    "require": {
        "php": "^8.5",
        "ext-amqp": "*",
        "ext-bcmath": "*",
        "ext-filter": "*",
        "ext-hash": "*",
        "ext-pdo": "*",
        "ext-pdo_mysql": "*",
        "ext-posix": "*",
        "ext-redis": "*",
        "ext-session": "*",
        "moneyphp/money": "^4.9",
        "monolog/monolog": "^3.12",
        "psr/clock": "^1.0",
        "psr/log": "^3.0",
        "robmorgan/phinx": "^0.16",
        "symfony/amqp-messenger": "^8.1",
        "symfony/event-dispatcher": "^8.1",
        "symfony/mailer": "^8.1",
        "symfony/messenger": "^8.1",
        "symfony/uid": "^8.1"
    },
    "require-dev": {
        "ext-json": "*",
        "deptrac/deptrac": "^4.7",
        "friendsofphp/php-cs-fixer": "^3.0",
        "league/openapi-psr7-validator": "^0.24",
        "nyholm/psr7": "^1.8",
        "phpstan/phpstan": "^2.1",
        "phpunit/phpunit": "^12.5",
        "symfony/browser-kit": "^8.1",
        "symfony/css-selector": "^8.1",
        "symfony/dom-crawler": "^8.1",
        "symfony/http-client": "^8.1"
    },
    "autoload": {
        "psr-4": {
            "App\\": "src/"
        }
    },
    "autoload-dev": {
        "psr-4": {
            "Tests\\": "tests/",
            "Tools\\": "tools/"
        }
    },
    "config": {
        "sort-packages": true
    },
    "scripts": {
        "test": "phpunit",
        "test-unit": "phpunit --testsuite Unit",
        "test-functional": "phpunit --testsuite Functional",
        "analyse": "phpstan analyse --configuration=phpstan.neon --no-progress --memory-limit=512M",
        "cs-check": "php-cs-fixer fix --dry-run --diff --config=.php-cs-fixer.dist.php",
        "cs-fix": "php-cs-fixer fix --config=.php-cs-fixer.dist.php",
        "deptrac": "deptrac analyse --config-file=deptrac.yaml --no-progress",
        "migrate": "phinx migrate -c phinx.php",
        "seed-demo": "phinx seed:run -c phinx.php -s DemoCatalogSeeder",
        "openapi-validate": "php-openapi validate ../openapi/openapi.yaml",
        "openapi-bundle": "php-openapi inline ../openapi/openapi.yaml ../build/openapi.yaml"
    }
}
