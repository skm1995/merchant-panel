parameters:
    level: 8
    paths:
        - src
        - public
        - tests
        - views
        - database/migrations
        - phinx.php
        - tools
        - bin
    excludePaths:
        # Imported legacy code awaiting replacement; see public/legacy/product-stock.php.
        - public/legacy
    tmpDir: .phpstan-cache

services:
    -
        class: Tools\PHPStan\HydratedRecordPropertiesExtension
        tags:
            - phpstan.properties.readWriteExtension
